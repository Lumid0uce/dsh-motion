{
  "name": "@local/dsh-motion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Restrained transitions for panel switches, rightbar tab changes, dialogs, menus and value-switch controls.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
